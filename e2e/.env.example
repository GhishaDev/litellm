# Copy to e2e/.env and fill in real keys. e2e/.env is gitignored.
#
# This file is for REAL-provider runs (Tier=real cases: 01, 02, 03, 05,
# 08, 09, 19, 24). For mock-only runs use `e2e/tools/proxy start
# --with-mock` — that overlays `e2e/.env.mock` (committed, no secrets)
# on top of this file, so you don't need to edit anything to switch
# modes.
#
# Only the keys you have are required; cases for missing providers will
# fail fast with a clear "API key missing" error from `e2e/tools/call`.
#
# Each block below is one provider, end-to-end. To add a new provider
# (Bedrock, Vertex, etc.), copy a block and rename.

# ─── Anthropic ────────────────────────────────────────────────────────
# Tier=real cases driving this: 01-04 (prompt-cache 5m/1h + read), 08, 09
# (per-key + per-team metric labels), 14 (response usage shape), 19
# (thinking-signature retry).
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=                    # default: provider native; set for gateway / region pin
MODEL_ANTHROPIC_SONNET=                # default: anthropic/claude-3-5-sonnet-20241022
MODEL_ANTHROPIC_HAIKU=                 # default: anthropic/claude-3-5-haiku-20241022

# ─── OpenAI ───────────────────────────────────────────────────────────
# Tier=real cases driving this: 05 (provider auto-cache), 06 (no
# creation-tokens metric for OpenAI), and any /v1/chat/completions
# probe that lands on openai/* by default.
OPENAI_API_KEY=
OPENAI_API_BASE=                       # default: https://api.openai.com/v1; or Azure / self-host
MODEL_OPENAI=                          # default: openai/gpt-4o-mini

# ─── Gemini ───────────────────────────────────────────────────────────
# Tier=real case driving this: 22 (gemini provider with custom api_base
# against an Anthropic-spec gateway exposed at /v1beta).
GEMINI_API_KEY=
GEMINI_API_BASE=                       # default: provider native; set for self-hosted /v1beta gateway
MODEL_GEMINI=                          # default: gemini/gemini-3.1-pro-preview

# ─── Bedrock-Anthropic gateway ────────────────────────────────────────
# Tier=real case driving this: 24 (anthropic_beta_overrides rewrite of
# advanced-tool-use-2025-11-20 → tool-search-tool-2025-10-19). Requires
# an Anthropic-spec front-end backed by Bedrock — config the gateway URL
# + key here. Leave blank if you don't have a Bedrock-Anthropic gateway.
BEDROCK_ANTHROPIC_GATEWAY_BASE=
BEDROCK_ANTHROPIC_GATEWAY_KEY=

# ─── Misc ─────────────────────────────────────────────────────────────
# E2E_PROXY_PORT=4011                  # override default proxy port if you have a conflict
