# Copy to e2e/.env and fill in real keys. e2e/.env is gitignored.
#
# This file is for REAL-provider runs (Tier=real cases: 01, 02, 03, 05,
# 08, 09, 19, 24). For mock-only runs use `e2e/tools/proxy start
# --with-mock` — that overlays `e2e/.env.mock` (committed, no secrets)
# on top of this file, so you don't need to edit anything to switch
# modes.
#
# Only the keys you have are required; cases for missing providers will
# fail fast with a clear "API key missing" error from `e2e/tools/call`.
#
# Each block below is one provider, end-to-end. To add a new provider
# (Bedrock, Vertex, etc.), copy a block and rename. Keep comments on
# their own lines — the .env parser doesn't strip inline `# trailers`
# (it would set the value to the comment text).

# ─── Anthropic ────────────────────────────────────────────────────────
# Tier=real cases driving this: 01-04 (prompt-cache 5m/1h + read), 08, 09
# (per-key + per-team metric labels), 14 (response usage shape), 19
# (thinking-signature retry).
ANTHROPIC_API_KEY=
# api_base default: provider native; set for gateway / region pin.
ANTHROPIC_API_BASE=
# Model default: anthropic/claude-sonnet-4-6
MODEL_ANTHROPIC_SONNET=
# Model default: anthropic/claude-haiku-4-5
MODEL_ANTHROPIC_HAIKU=

# ─── OpenAI ───────────────────────────────────────────────────────────
# Tier=real cases driving this: 05 (provider auto-cache), 06 (no
# creation-tokens metric for OpenAI), and any /v1/chat/completions
# probe that lands on openai/* by default.
OPENAI_API_KEY=
# api_base default: https://api.openai.com/v1; or Azure / self-host.
OPENAI_API_BASE=
# Model default: openai/gpt-4o-mini
MODEL_OPENAI=

# ─── Gemini ───────────────────────────────────────────────────────────
# Tier=real case driving this: 22 (gemini provider with custom api_base
# against an Anthropic-spec gateway exposed at /v1beta).
GEMINI_API_KEY=
# api_base default: provider native; set for self-hosted /v1beta gateway.
GEMINI_API_BASE=
# Model default: gemini/gemini-3.1-pro-preview
MODEL_GEMINI=

# ─── Bedrock-Anthropic gateway ────────────────────────────────────────
# Tier=real case driving this: 24 (anthropic_beta_overrides rewrite of
# advanced-tool-use-2025-11-20 → tool-search-tool-2025-10-19). Requires
# an Anthropic-spec front-end backed by Bedrock — config the gateway URL
# + key here. Leave blank if you don't have one.
BEDROCK_ANTHROPIC_GATEWAY_BASE=
BEDROCK_ANTHROPIC_GATEWAY_KEY=

# ─── GLM (Zhipu) ──────────────────────────────────────────────────────
# Only required if you're running e2e/tools/glm_repro or want a GLM-5.1
# deployment registered in the proxy config. Background: GLM-5.1 with
# thinking exhibits long-tail responses (p50 ~50s, p90 ~120s, max 170s+)
# and z.ai's SG POP can stall mid-stream for >300s on ~25% of requests
# from APAC source IPs. The repro tool measures + logs all of this.
GLM_API_KEY=
# api_base default: https://api.z.ai/api/paas/v4
GLM_API_BASE=
# Model default: glm-5.1
MODEL_GLM=

# ─── Misc ─────────────────────────────────────────────────────────────
# Override default proxy port (4011) if you have a conflict.
# E2E_PROXY_PORT=4011

# ─── e2e/tools/glm_repro tunables ─────────────────────────────────────
# All overridable from shell at run-time. Blank value = code default.
# See top of e2e/tools/glm_repro for the full docstring.
#
# REPRO_CHUNK_LOG: timeline JSONL verbosity for per-chunk events
#   full        — every chunk (huge: 7k+/req for thinking models)
#   interesting — first 3 chunks + gap_warn triggers (default)
#   none        — only request_start / headers / first_chunk /
#                 first_answer / usage_chunk / finish / error events
REPRO_CHUNK_LOG=interesting
# REPRO_GAP_WARN_S: emit gap_warn event when inter-chunk gap ≥ this
REPRO_GAP_WARN_S=3.0
# REPRO_TIMELINE: output path (blank → /tmp/glm-repro-<YYYYMMDD-HHMMSS>.jsonl)
REPRO_TIMELINE=
# REPRO_MAX_TOKENS: cap completion tokens (incl. thinking). Blank = unlimited
REPRO_MAX_TOKENS=
# REPRO_FORCE_IP: force a specific A-record for api.z.ai (curl --resolve
# equivalent). Useful for A/B'ing POPs:
#   128.14.69.45    = US POP (AS62610, Diamond Bar CA, stable)
#   98.98.124.205   = SG POP (AS21859, Singapore, intermittent stalls)
REPRO_FORCE_IP=
# REPRO_MODE: target = direct (default, hits GLM_API_BASE) | proxy (hits
# local e2e proxy at http://localhost:4011 with sk-e2e-test)
REPRO_MODE=direct
