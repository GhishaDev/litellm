# ------------------------------------------------------------------ 04
case_04() {
    echo "[04] no-cache baseline..."
    local b5 br seed usage_cc usage_cr d5 dr
    b5=$(snap_sum litellm_input_cache_creation_tokens_metric anthropic 'cache_ttl="5m"')
    br=$(snap_sum litellm_input_cached_tokens_metric anthropic)
    seed="case04-$$-$(date +%s)"
    local resp
    resp=$(e2e/tools/call --provider anthropic --cache none \
        --prompt-tokens 1500 --seed "$seed" \
        --user-id "case04-user-$seed" 2>/dev/null)
    usage_cc=$(echo "$resp" | jq -r '.response.usage.cache_creation_input_tokens // 0')
    usage_cr=$(echo "$resp" | jq -r '.response.usage.cache_read_input_tokens // 0')
    sleep 1
    local a5 ar
    a5=$(snap_sum litellm_input_cache_creation_tokens_metric anthropic 'cache_ttl="5m"')
    ar=$(snap_sum litellm_input_cached_tokens_metric anthropic)
    d5=$((a5 - b5))
    dr=$((ar - br))
    if [ "$usage_cc" -eq 0 ] && [ "$usage_cr" -eq 0 ] && [ "$d5" -eq 0 ] && [ "$dr" -eq 0 ]; then
        ok "04 no-cache-baseline: metrics unchanged"
    else
        fail "04 no-cache-baseline" "usage_cc=$usage_cc usage_cr=$usage_cr d5=$d5 dr=$dr"
    fi
}

# ------------------------------------------------------------------ 05
case_05() {
    echo "[05] openai/glm cache read..."
    local before after seed cached delta
    before=$(snap_sum litellm_input_cached_tokens_metric openai)
    seed="case05-$$-$(date +%s)"
    e2e/tools/call --provider openai --prompt-tokens 1800 --seed "$seed" > /dev/null 2>&1
    sleep 2
    local resp
    resp=$(e2e/tools/call --provider openai --prompt-tokens 1800 --seed "$seed" 2>/dev/null)
    cached=$(echo "$resp" | jq -r '.response.usage.prompt_tokens_details.cached_tokens // 0')
    sleep 1
    after=$(snap_sum litellm_input_cached_tokens_metric openai)
    delta=$((after - before))
    if [ "$cached" -gt 0 ] && [ "$delta" -ge "$cached" ]; then
        ok "05 openai-cache-read: cached=$cached, metric_delta=$delta"
    else
        fail "05 openai-cache-read" "cached=$cached, delta=$delta"
    fi
}

