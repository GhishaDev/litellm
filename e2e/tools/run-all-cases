#!/usr/bin/env bash
# Master runner for the e2e case suite.
#
# Runs every case in sequence, prints a single PASS / FAIL / SKIP line for
# each, and a final summary. Exit 0 iff zero FAILs.
#
# Usage:
#   e2e/tools/run-all-cases                # full suite, ~$0.05 in provider cost
#   e2e/tools/run-all-cases --skip-paid    # skip cases that call real providers
#                                          # (10, 12 only — they're free)
#   e2e/tools/run-all-cases --mock-only    # only Tier=mock|both cases (see
#                                          # cases/README.md tier column),
#                                          # against the in-network mock
#                                          # provider — zero provider cost.
#                                          # Caller is responsible for starting
#                                          # the proxy with `proxy start --with-mock`
#                                          # and pointing API_BASE env to the mock.
#
# Convention for adding a new case:
#   1. Drop a fixture under e2e/cases/data/NN_*.sh or NN_*.py
#   2. Add a `_run_case NN <invocation>` line in main() below
#   3. Fixture must exit 0 on PASS, 77 on SKIP, anything else FAIL
#
# Detailed metric-comparison cases (01, 02, 04, 05, 06, 07, 08, 09) are
# still inline here because they assert against /metrics across two
# snapshots. The other cases delegate fully to their fixtures.

set -u

PROXY="${PROXY_URL:-http://localhost:4011}"
DB_CONTAINER="${DB_CONTAINER:-litellm-e2e-db}"
PROXY_CONTAINER="${PROXY_CONTAINER:-litellm-e2e}"
MASTER_KEY="${MASTER_KEY:-sk-e2e-test}"
SKIP_PAID=0
MOCK_ONLY=0
for arg in "$@"; do
    case "$arg" in
        --skip-paid) SKIP_PAID=1 ;;
        --mock-only) MOCK_ONLY=1 ;;
        -h|--help)
            sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
    esac
done

# Tier=real cases that --mock-only skips. See e2e/cases/README.md index.
# 04 + 06 are Tier=both (cache metrics ABSENT — provable on mock); the
# rest of 01-09 verify cache TOKEN VALUES that real providers compute.
REAL_ONLY_CASES="01 02 03 05 08 09 19 33"

is_real_only() {
    local n="$1"
    for r in $REAL_ONLY_CASES; do
        [ "$r" = "$n" ] && return 0
    done
    return 1
}

PASS=0; FAIL=0; SKIP=0
RESULTS=()
ok()   { PASS=$((PASS+1)); RESULTS+=("  PASS  $1"); }
fail() { FAIL=$((FAIL+1)); RESULTS+=("  FAIL  $1 ($2)"); }
skip() { SKIP=$((SKIP+1)); RESULTS+=("  SKIP  $1 ($2)"); }

# Sum across all series matching a metric+labels selector.
#
# Why sum and not "last value": /metrics has one independent series per
# unique label combination (per-key, per-team, per-user, …). Across a
# test session the same metric grows new series as virtual keys / teams
# get minted. Picking "the last matching line" silently swaps which
# series we're comparing across two snapshots and produces a bogus
# negative delta. Summing across all matching series gives a stable
# total even as new series appear.
snap_sum() {
    local metric="$1" provider="$2" extra_label="${3:-}"
    local pat="^${metric}_total{[^}]*api_provider=\"${provider}\""
    [ -n "$extra_label" ] && pat="${pat}[^}]*${extra_label}"
    curl -sSL "$PROXY/metrics" 2>/dev/null \
        | awk -v p="$pat" '
            $0 ~ p {
                # Sum the trailing numeric value on each matching line.
                # Metric value is the last whitespace-separated field.
                sum += $NF + 0
            }
            END { printf "%.0f\n", sum }
        '
}

# ------------------------------------------------------------------ 01
case_01() {
    echo "[01] anthropic 5m TTL creation..."
    local before after seed usage delta
    before=$(snap_sum litellm_input_cache_creation_tokens_metric anthropic 'cache_ttl="5m"')
    seed="case01-$$-$(date +%s)"
    local resp
    resp=$(e2e/tools/call --provider anthropic --cache ephemeral --ttl 5m \
        --prompt-tokens 1500 --seed "$seed" --user-id "case01-user-$seed" 2>/dev/null)
    usage=$(echo "$resp" | jq -r '.response.usage.cache_creation_input_tokens // 0')
    sleep 1
    after=$(snap_sum litellm_input_cache_creation_tokens_metric anthropic 'cache_ttl="5m"')
    delta=$((after - before))
    if [ "$usage" -gt 0 ] && [ "$delta" -ge "$((usage - 1))" ] && [ "$delta" -le "$((usage + 50))" ]; then
        ok "01 anthropic-5m-creation: usage=$usage, metric_delta=$delta"
    else
        fail "01 anthropic-5m-creation" "usage=$usage, delta=$delta (before=$before after=$after)"
    fi
}

