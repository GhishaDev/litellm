# Mock-only preflight: verify the mock container is up AND the
# ANTHROPIC/OPENAI/GEMINI_API_BASE env vars baked into the rendered
# config actually point at the mock. Without that redirect, cases that
# call `claude-sonnet-cache` / `gpt-4o-mini-cache` etc. hit real
# providers and either burn money or fail with auth errors.
if [ "$MOCK_ONLY" -eq 1 ]; then
    # 1. Mock container running?
    if ! docker ps --format '{{.Names}}' 2>/dev/null \
            | grep -qx 'litellm-e2e-mock'; then
        echo "FATAL: --mock-only requires the litellm-e2e-mock sidecar."
        echo "Restart the proxy with the mock profile:"
        echo "  e2e/tools/proxy stop && e2e/tools/proxy start --with-mock"
        exit 2
    fi
    # 2. Rendered config must redirect at least one real-provider api_base
    #    to the mock. Cheapest probe: grep the rendered yaml the proxy
    #    just loaded.
    rendered=e2e/_config/.litellm.rendered.yaml
    if [ ! -f "$rendered" ] || \
       ! grep -qE "http://mock:8080|os.environ/ANTHROPIC_API_BASE" "$rendered"; then
        echo "FATAL: --mock-only needs ANTHROPIC_API_BASE / OPENAI_API_BASE / GEMINI_API_BASE"
        echo "to point at the mock so cases like 13/14/18/20/22 don't hit real providers."
        echo "Set in e2e/.env then restart the proxy:"
        cat <<'EOF'
  ANTHROPIC_API_BASE=http://mock:8080
  OPENAI_API_BASE=http://mock:8080/v1
  GEMINI_API_BASE=http://mock:8080/v1beta
  # tuned so case 13's TTFT/streaming_phase assertions pass:
  MOCK_TTFT_MS=500
  MOCK_TPS=50
  MOCK_CHUNKS=200

  e2e/tools/proxy stop && e2e/tools/proxy start --with-mock
EOF
        exit 2
    fi
    # 3. Heuristic: make sure ANTHROPIC_API_BASE actually points at mock.
    #    The container reads this from the env_file. Inspect it via the
    #    running container so we don't depend on shell-side state.
    base=$(docker exec litellm-e2e bash -c 'echo "${ANTHROPIC_API_BASE:-}"' 2>/dev/null)
    if ! echo "$base" | grep -q 'mock:8080'; then
        echo "FATAL: --mock-only: ANTHROPIC_API_BASE inside the proxy container is '$base',"
        echo "not pointing at http://mock:8080. The proxy will hit a real Anthropic endpoint."
        echo "Edit e2e/.env (see fix instructions above), then:"
        echo "  e2e/tools/proxy stop && e2e/tools/proxy start --with-mock"
        exit 2
    fi
fi

