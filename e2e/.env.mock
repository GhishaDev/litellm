# Mock-mode overlay for `e2e/tools/proxy start --with-mock`. Committed
# (no secrets). Mirrors `e2e/.env.example` per-provider blocks so users
# see exactly which vars get overridden in mock mode vs left to .env.
#
# Precedence at load time:
#   shell env > e2e/.env.mock (this file, overlay) > e2e/.env > defaults
#
# Only fields that NEED a mock value are set here. Model identifiers
# stay blank → fall back to the same litellm model strings used in real
# runs (the mock provider responds to any model name, so identical
# routing keeps the proxy config identical too).
#
# To run mock-only:
#   e2e/tools/proxy stop
#   e2e/tools/proxy start --with-mock
#   e2e/tools/run-all-cases --mock-only

# ─── Anthropic ────────────────────────────────────────────────────────
# Dummy key + api_base steered at the in-network mock sidecar
# (hostname `mock` resolved by Docker DNS inside the e2e network).
ANTHROPIC_API_KEY=sk-mock-not-used
ANTHROPIC_API_BASE=http://mock:8080
MODEL_ANTHROPIC_SONNET=
MODEL_ANTHROPIC_HAIKU=

# ─── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-mock-not-used
OPENAI_API_BASE=http://mock:8080/v1
MODEL_OPENAI=

# ─── Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=sk-mock-not-used
GEMINI_API_BASE=http://mock:8080/v1beta
MODEL_GEMINI=

# ─── Bedrock-Anthropic gateway ────────────────────────────────────────
# Case 24 (anthropic_beta_overrides_bedrock_gateway) is Tier=real and
# SKIPs under --mock-only — the mock can't reproduce Bedrock's beta-flag
# validation. Left blank here on purpose.
BEDROCK_ANTHROPIC_GATEWAY_BASE=
BEDROCK_ANTHROPIC_GATEWAY_KEY=

# ─── Mock provider tuning ─────────────────────────────────────────────
# See e2e/_config/mock_provider.py. case 13 (passthrough TTFT) asserts
# `streaming_phase > 300 ms` so MOCK_TTFT_MS must stay >= 500.
MOCK_TTFT_MS=500
MOCK_TPS=50
MOCK_CHUNKS=200
