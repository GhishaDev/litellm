# Mock-mode overlay for `e2e/tools/proxy start --with-mock`.
#
# This file is COMMITTED — it contains no secrets. When `--with-mock` is
# set the proxy starts the in-network mock provider sidecar (see
# `e2e/_config/docker-compose.yml` profile `mock`) and these vars
# overlay `e2e/.env` so api_base points at the mock service and keys are
# dummy strings.
#
# To run mock-only e2e:
#   e2e/tools/proxy stop
#   e2e/tools/proxy start --with-mock
#   e2e/tools/run-all-cases --mock-only
#
# Real-provider runs use `e2e/.env` (gitignored, copied from
# `e2e/.env.example`). The two never need to be edited together.

ANTHROPIC_API_KEY=sk-mock-not-used
OPENAI_API_KEY=sk-mock-not-used
GEMINI_API_KEY=sk-mock-not-used

# api_base values point at the mock container inside the e2e compose
# network (hostname `mock`, port 8080). The host-side proxy resolves
# these via Docker's embedded DNS.
ANTHROPIC_API_BASE=http://mock:8080
OPENAI_API_BASE=http://mock:8080/v1
GEMINI_API_BASE=http://mock:8080/v1beta

# Mock provider response shape — case 13 (passthrough TTFT) requires
# MOCK_TTFT_MS >= 500 so its `streaming_phase > 300 ms` assertion holds.
MOCK_TTFT_MS=500
MOCK_TPS=50
MOCK_CHUNKS=200
